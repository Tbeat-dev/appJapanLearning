<script>
  // Simple interactive selection logic for playful UX
  (function() {
    const labels = document.querySelectorAll('#quiz-options-cluster .quiz-option');
    labels.forEach(label => {
      label.addEventListener('click', function() {
        labels.forEach(l => {
          l.classList.remove('bg-primary-fixed', 'text-primary-container');
          l.classList.add('bg-surface-container-lowest', 'text-on-surface');
          const badge = l.querySelector('span:first-child');
          if (badge) {
            badge.className = 'w-7 h-7 rounded-full bg-surface-container-high text-on-surface flex items-center justify-center font-label-md text-label-md font-bold shrink-0';
          }
          const textSpan = l.querySelector('span:nth-child(2)');
          if (textSpan) {
            textSpan.className = 'font-body-lg text-body-lg text-on-surface tracking-wide';
          }
          const indicator = l.querySelector('div:last-child');
          if (indicator) {
            indicator.className = 'w-5 h-5 rounded-full bg-surface-container-highest shrink-0 flex items-center justify-center';
            indicator.innerHTML = '';
          }
        });

        this.classList.remove('bg-surface-container-lowest', 'text-on-surface');
        this.classList.add('bg-primary-fixed', 'text-primary-container');
        const badge = this.querySelector('span:first-child');
        if (badge) {
          badge.className = 'w-7 h-7 rounded-full bg-primary-container text-on-primary flex items-center justify-center font-label-md text-label-md font-bold shrink-0';
        }
        const textSpan = this.querySelector('span:nth-child(2)');
        if (textSpan) {
          textSpan.className = 'font-body-lg text-body-lg text-primary-container font-semibold tracking-wide';
        }
        const indicator = this.querySelector('div:last-child');
        if (indicator) {
          indicator.className = 'w-6 h-6 rounded-full bg-primary-container text-on-primary shrink-0 flex items-center justify-center shadow-xs';
          indicator.innerHTML = '<span class="material-symbols-outlined text-[16px]">check</span>';
        }
      });
    });
  })();
